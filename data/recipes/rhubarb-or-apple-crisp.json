{
  "id": "rhubarb-or-apple-crisp",
  "title": "Rhubarb (or Apple) Crisp",
  "categories": {
    "method": [
      "baking"
    ],
    "diet": [
      "vegetarian",
      "pescatarian"
    ],
    "meal": [
      "dessert"
