  "steps": [
    {
      "id": "s1",
      "text": "Heat olive oil in a large heavy pan over medium-high heat. Add onions, chorizo and garlic and cook, stirring, until onions begin to soften, about 10 minutes."
    },
    {
      "id": "s2",
      "text": "Add beef and brown it, crumbling with a fork. Season with salt and pepper."
    },
    {
      "id": "s3",
      "text": "Stir in tomatoes, vinegar, cinnamon, cumin, bay leaves, cloves and nutmeg. Lower heat, cover and simmer for about 30 minutes."
    },
    {
      "id": "s4",
      "text": "Uncover, add raisins and olives, and cook for about 15 minutes more. Serve with white rice if desired."
    }
  ],
