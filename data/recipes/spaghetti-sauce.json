  "steps": [
    {
      "id": "s1",
      "text": "In a large deep skillet over medium-high heat, put olive oil and heat."
    },
    {
      "id": "s2",
      "text": "Add onion and green pepper and saute over medium-high heat for 5 minutes, add garlic and saute 2 minutes more. Remove."
    },
    {
      "id": "s3",
      "text": "Add more olive oil if necessary, saute meats. Return veggies. Add tomato paste and mix well."
    },
    {
      "id": "s4",
      "text": "Add crushed tomatoes, all seasonings, and stock or wine. Bring nearly to a boil, cover, turn heat to low and simmer, partially covered, for 45 minutes."
    },
    {
      "id": "s5",
      "text": "Taste for seasoning. Add mushrooms and more liquid if necessary, simmer 10 more minutes. Allow to cool, then refrigerate."
    }
  ],
  "notes": "TO SERVE: Reheat, adjust seasonings if necessary. Add parsley or basil, if available. Serve with Parmesan cheese. ReServe with Parmesan.",
