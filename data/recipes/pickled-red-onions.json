  "ingredients": [
    {
      "id": "i1",
      "name": "jalapeño pepper, cut into 1/4-inch rings",
      "amount": 1,
      "unit": null,
      "notes": ""
    },
    {
      "id": "i2",
      "name": "large red onions, finely sliced",
      "amount": 2,
      "unit": null,
      "notes": "about 1 quart"
    },
    {
      "id": "i3",
      "name": "distilled white vinegar",
      "amount": 1,
      "unit": "cup",
      "notes": ""
    },
    {
      "id": "i4",
      "name": "kosher salt",
      "amount": 2,
      "unit": "tsp",
      "notes": ""
    },
    {
      "id": "i5",
      "name": "water",
      "amount": 1,
      "unit": "cup",
      "notes": ""
    },
    {
      "id": "i6",
      "name": "sugar",
      "amount": 0.25,
      "unit": "cup",
      "notes": ""
    }
  ],
  "steps": [
    {
      "id": "s1",
      "text": "Place jalapeño and onions in a medium mixing bowl."
    },
    {
      "id": "s2",
      "text": "Heat vinegar, water, sugar, and salt in a small skillet over high heat, whisking until sugar is dissolved. Bring to a boil, then pour over onions."
    },
    {
      "id": "s3",
      "text": "Press onions down with a spoon until submerged. Place a double layer of paper towels on top of onions and press down until completely saturated in liquid to keep onions submerged."
    },
    {
      "id": "s4",
      "text": "Allow to sit until onions are softened and liquid has cooled, about 25 minutes."
    }
  ],
  "notes": "Onions will keep indefinitely in a sealed container in the refrigerator.",
