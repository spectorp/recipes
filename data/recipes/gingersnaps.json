  "steps": [
    {
      "id": "s1",
      "text": "Beat butter and sugar with an electric mixer until light and fluffy."
    },
    {
      "id": "s2",
      "text": "Add egg and molasses; beat until thoroughly mixed."
    },
    {
      "id": "s3",
      "text": "Sift together flour, salt, soda, cinammon, ginger, nutmeg, and cloves. Add to molasses mixture a little at a time, mixing well. If dough is soft, chill before next step."
    },
    {
      "id": "s4",
      "text": "Roll generous teaspoons of dough between palms to form balls. Roll balls in sugar (optional) and place on greased baking sheets, leaving 1.5\" between them."
    },
    {
      "id": "s5",
      "text": "Bake at 350° for about 12-15 minutes. Remove to a rack and let cool. Store in a loosely covered container."
    }
  ],
