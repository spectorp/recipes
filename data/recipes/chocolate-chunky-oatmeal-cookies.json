  "steps": [
    {
      "id": "s1",
      "text": "With electric mixer on medium speed, cream butter and sugars. Add eggs and vanilla."
    },
    {
      "id": "s2",
      "text": "In another bowl, combine flour, baking soda, baking powder, salt, and rolled oats."
    },
    {
      "id": "s3",
      "text": "With mixer on low speed, blend ingredients into creamed mixture."
    },
    {
      "id": "s4",
      "text": "Fold in chocolate and walnuts by hand. Drop dougn by rounded teaspoons onto ungreased sheet pan."
    },
    {
      "id": "s5",
      "text": "Bake in preheated 325 degree oven for 12-14 minutes. Transfer to wire rack to cool."
    }
  ],
  "notes": "Very good. Yield: Few dozen cookies.",
