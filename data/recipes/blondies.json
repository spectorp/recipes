  "steps": [
    {
      "id": "s1",
      "text": "Grease a 9 X 9\" pan."
    },
    {
      "id": "s2",
      "text": "Melt butter in a saucepan (can boil for 4 minutes until light brown in color, stirring constantly)."
    },
    {
      "id": "s3",
      "text": "Add brown sugar, mix in, allow to cool."
    },
    {
      "id": "s4",
      "text": "Add eggs and vanilla: beat well."
    },
    {
      "id": "s5",
      "text": "Sift together dry ingredients and add."
    },
    {
      "id": "s6",
      "text": "Heat oven to 350. Add chocolate chips and/or pecans."
    },
    {
      "id": "s7",
      "text": "Spread in prepared pan. Bake for 25 minutes."
    }
  ],
  "notes": "Easy & delicious, great for mailing to college. Freezes well if well sealed. Double recipe fits perfectly in an 11 x 15\" pan.",
