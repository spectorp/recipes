  "steps": [
    {
      "id": "s1",
      "text": "Melt butter in a heavy large saucepan over low heat. Add onions and garlic and cook uncovered until wilted, about 25 minutes."
    },
    {
      "id": "s2",
      "text": "Add stock and heat to boiling."
    },
    {
      "id": "s3",
      "text": "Cut asparagus into 1 in pieces. Reserve tips. Add asparagus pieces, parsley, carrots, basil, tarragon, salt, pepper, and cayenne to stock. Reduce heat to medium-low and simmer, covered, until veggies are tender, about 50 minutes."
    },
    {
      "id": "s4",
      "text": "Remove soup from heat and let cool. Process in batches in a blender or food processor until smooth. (Can strain soup through a medium-size sieve to remove woody fibers.)"
    },
    {
      "id": "s5",
      "text": "When ready to serve, return strained soup to saucepan, add asparagus tips, and simmer over medium heat until tips are tender, about 10 minutes."
    },
    {
      "id": "s6",
      "text": "Ladle soup into soup bowls. Dollop each serving with sour cream and sprinkle with diced tomato."
    }
  ],
