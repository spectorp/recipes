    }
  ],
  "steps": [
    {
      "id": "s1",
      "text": "Bring farro, apple cider, kosher salt, bay leaves and 2 cups water to a simmer in a medium saucepan. Simmer until farro is tender and liquid evaporates, about 30 minutes, adding water if needed. Cool and discard bay leaves."
    },
    {
      "id": "s2",
      "text": "Whisk olive oil, lemon juice and a pinch of salt in a salad bowl. Add farro, Parmesan and pistachios and mix well. Just before serving, fold in arugula, herbs, tomatoes, radish and flaky salt to taste."
    }
  ],
  "notes": "The dressed farro base keeps for up to 4 hours at room temperature or overnight refrigerated; bring it to room temperature before serving. Almonds may replace pistachios, and seasonal vegetables or herbs may be substituted.",
