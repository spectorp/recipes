  "ingredients": [
    {
      "id": "i1",
      "name": "farro",
      "amount": 1,
      "unit": "cup"
    },
    {
      "id": "i2",
      "name": "apple cider",
      "amount": 1,
      "unit": "cup",
      "notes": "not cider vinegar"
    },
    {
      "id": "i3",
      "name": "kosher salt",
      "amount": 2,
      "unit": "tsp",
      "notes": "plus more as needed"
    },
    {
      "id": "i4",
      "name": "bay leaves",
      "amount": 2,
      "unit": null
    },
    {
      "id": "i5",
      "name": "extra-virgin olive oil",
      "amount": 8,
      "unit": "tbsp"
    },
    {
      "id": "i6",
      "name": "fresh lemon juice",
      "amount": 2,
      "unit": "tbsp"
    },
    {
      "id": "i7",
      "name": "Parmesan cheese",
      "amount": 70,
      "unit": "g",
      "notes": "1/2 cup, shaved with a vegetable peeler"
    },
    {
      "id": "i8",
      "name": "pistachio nuts",
      "amount": 70,
      "unit": "g",
      "notes": "1/2 cup, chopped"
    },
    {
      "id": "i9",
      "name": "arugula leaves",
      "amount": 2,
      "unit": "cup"
    },
    {
      "id": "i10",
      "name": "parsley or basil leaves",
      "amount": 1,
      "unit": "cup",
      "notes": "torn"
    },
    {
      "id": "i11",
      "name": "mint leaves",
      "amount": 1,
      "unit": "cup"
    },
    {
      "id": "i12",
      "name": "cherry or grape tomatoes",
      "amount": 0.75,
      "unit": "cup",
      "notes": "halved"
    },
    {
      "id": "i13",
      "name": "radish",
      "amount": 0.3333333333,
      "unit": "cup",
      "notes": "thinly sliced"
    },
    {
      "id": "i14",
      "name": "Maldon or other flaky sea salt",
      "amount": 1,
      "unit": "pinch",
