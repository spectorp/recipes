  "tags": [],
  "servings": 4,
  "ingredients": [
    {
      "id": "i1",
      "name": "tomatoes (3/4 pounds)",
      "amount": 2,
      "unit": "cup",
      "notes": ""
    },
    {
      "id": "i2",
      "name": "large sweet onion, coarsely chopped",
      "amount": 1,
      "unit": null,
      "notes": ""
    },
    {
      "id": "i3",
      "name": "cloves garlic, coarsely chopped",
      "amount": 2,
      "unit": null,
      "notes": ""
    },
    {
      "id": "i4",
      "name": "olive oil",
      "amount": 0.25,
      "unit": "cup",
      "notes": ""
    },
    {
      "id": "i5",
      "name": "salt",
      "amount": 1.5,
      "unit": "tsp",
      "notes": ""
    },
    {
      "id": "i6",
      "name": "pepper",
      "amount": 0.5,
      "unit": "tsp",
      "notes": ""
    },
    {
      "id": "i7",
      "name": "zucchini (1/2 pound), chopped",
      "amount": 2,
      "unit": "cup",
      "notes": ""
    },
    {
      "id": "i8",
      "name": "15 oz can garbonzo beans",
      "amount": 1,
      "unit": null,
      "notes": ""
    },
    {
      "id": "i9",
      "name": "basil leaves, torn",
      "amount": 0.5,
      "unit": "cup",
      "notes": ""
    },
    {
      "id": "i10",
      "name": "kalamata olives, pitted and diced",
      "amount": 0.25,
      "unit": "cup",
      "notes": ""
    },
    {
      "id": "i11",
      "name": "red wine vinegar (or more to taste)",
      "amount": 1,
      "unit": "tbsp",
      "notes": ""
    }
  ],
  "steps": [
    {
      "id": "s1",
      "text": "Gently seed tomatoes (unless using cherry tomatoes). Cut into 1/2\" slices, then cut large slices into halves or quarters. Let drain while preparing remaining veggies."
    },
    {
      "id": "s2",
      "text": "Preheat oven to 450 degrees."
    },
    {
      "id": "s3",
      "text": "Combine tomatoes, onion, garlic, and olive oil in a single layer roasting pan; season with salt and pepper. Roast for 10 minutes. Using spatula, turn veggies and roast 10 minutes more or until lightly browned."
    },
    {
      "id": "s4",
      "text": "Drain garbonzo beans, rinse, and mash lightly with a fork. You may want to pick out the bean skins. Add beans and zucchini to roasting pan. Roast until zucchini is tender, about 10-15 minutes. Remove from oven and cool to room temperature."
    },
    {
      "id": "s5",
      "text": "Spoon mixture into large bowl. Add basil, olives, vinegar, and additional salt, pepper, and olive oil to taste. Serve chilled or at room temperature as appetizer or vegetable dish."
    }
  ],
  "notes": "",
