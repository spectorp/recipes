  "ingredients": [
    {
      "id": "i1",
      "name": "all-purpose flour",
      "amount": 1.5,
      "unit": "cup",
      "notes": ""
    },
    {
      "id": "i2",
      "name": "unsweetened cocoa",
      "amount": 0.6666666666666666,
      "unit": "cup",
      "notes": ""
    },
    {
