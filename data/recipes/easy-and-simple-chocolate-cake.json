  "steps": [
    {
      "id": "s1",
      "text": "Heat oven to 350 F"
    },
    {
      "id": "s2",
      "text": "Mix flour, cocoa, baking soda, sugar, and salt. In separate bowl, whisk together water, oil, vanilla, and vinegar."
    },
    {
      "id": "s3",
      "text": "Whisk wet and dry mixtures together. If lumpy, whisk until smooth."
    },
    {
      "id": "s4",
      "text": "Pour into a greased 9 inch round cake pan. Bang on counter several times to eliminate air bubbles."
    },
    {
      "id": "s5",
      "text": "Bake for 25-30 minutes, or until the top springs back when pressed gently."
    },
    {
      "id": "s6",
      "text": "Cool before removing from pan, and dust with powdered sugar."
    }
  ],
