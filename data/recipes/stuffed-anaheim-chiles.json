  "steps": [
    {
      "id": "s1",
      "text": "Preheat oven to 375. Oil a tian or baking sheet."
    },
    {
      "id": "s2",
      "text": "Halve peppers lengthwise (across width) and seed; arrange on baking sheet."
    },
    {
      "id": "s3",
      "text": "Combine all remaining ingredients except sour cream in a mixing bowl, and toss thoroughly. Fill pepper halves."
    },
    {
      "id": "s4",
      "text": "Bake until peppers are tender and filling is heated through, about 30 minutes."
    },
    {
      "id": "s5",
      "text": "Serve immediately, topped with a dollop of sour cream."
    }
  ],
