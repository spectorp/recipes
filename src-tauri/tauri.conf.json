{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recipes",
  "version": "0.1.0",
  "identifier": "io.github.spectorp.recipes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Recipes",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 520,
        "backgroundColor": "#f7f4ef"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
